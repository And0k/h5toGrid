AddCustom('import', 'importlib', 'util')
AddCustom('import', 'itertools', 'dropwhile')
AddCustom('import', 'logging', 'warning')
AddCustom('import', 'pathlib', 'Path')
AddCustom('import', 'sys', 'argv')
AddCustom('import', 're', 'match')
AddCustom('definition', 'USE_timeShift_s', '3600*2  # draw in local zone (imput data in UTC)')
AddCustom('definition', 'DISPtime', "[['2022-08-10T11:16', '2022-08-10T15:22']]  # datetime64('now', 'D') + 1]]  # graph auto time range in local zone")
AddCustom('definition', 'USEtime__', "array(DISPtime, 'M8[s]') - array(USE_timeShift_s, 'm8[s]')  # data range, UTC #+ array([[-2, 2]], 'm8[h]')")
AddCustom('definition', 'Dir0proj', '-55  # degrees, axes rotation')
AddCustom('definition', 'USE_bursts', 'False')
AddCustom('definition', 'DISP_vecScale', '0.005')
AddCustom('definition', 'DISP_max_u', '60')
AddCustom('definition', 'DISP_vecY0', '0.4')
AddCustom('definition', 'DISP_legY', '0.84  # legend position relative to axis y[0,1] (bot: 0.1, top: 0.85)')
AddCustom('definition', 'DISPprogress_x_lims', '[-600, 600]')
AddCustom('definition', 'DISPprogress_y_min', '-10')
AddCustom('definition', 'DISPprogress_scale', 'DISP_vecScale*15*2')
AddCustom('definition', 'DISPprogress_scale0', '0.01')
AddCustom('definition', 'DISP_labels_freq', "'h'  # Y,M,D,h,m,s for year, month, day... if str else divider of used data timerange")
AddCustom('definition', 'DISP_LegVorig_mul', '2.5  # decrease size and increase legend value multiplier for original sampled vectors')
AddCustom('definition', 'DISP_vecY0_shift', '0.2')
AddCustom('definition', 'f', 'lambda fun, *args, **kwargs: fun(*args, **kwargs)')
AddCustom('definition', 'sl_(x)', 'slice(*int32(ravel(x)))')
AddCustom('definition', 'argv1', "argv[1] if argv[1]!='--embed-remote' else ENVIRON.get('VSZ_PATH', FILENAME())")
AddCustom('definition', 'import_file(path, module_name)', "( lambda spec: (lambda mod: ( spec.loader.exec_module(mod), mod, warning(f'loading {mod}'))[1] )(util.module_from_spec(spec)) )(util.spec_from_file_location(module_name, (lambda fpy: fpy(next(dropwhile(lambda p: not fpy(p).is_file(), path.parents))))(lambda p: (p / module_name).with_suffix('.py'))))")
AddCustom('definition', 'v', "import_file(Path(argv1), 'func_vsz')")
AddCustom('definition', '_id', "f(f(('%s' % match(r'(?:[^#@]*[_#@\\d])?([^_#@\\d]+[^.]+)', BASENAME()).group(1)).replace, '\\\\','').replace, 'ref',', sp')")
AddCustom('definition', 'DISPinfo', "{'id': _id, 'device': 'trackers', 'measure': 'Displacement', 'units': 'm', 'nature': 'position difference', 'letter': 'r', 'averaging': 'Averaging bin: {}', 'sampling': 'Sampling interval: {}'}")
AddCustom('definition', 'DISPdevice', "{_id: f(fr'{_id}'.replace, ', ', r' relative to ')}  # \\\\40m")
AddCustom('definition', 'f_dt64s2vsz(dt64)', "int32(dt64) - (1230768000 - USE_timeShift_s)  # 1230768000 = int32(datetime64('2009-01-01T00:00:00'))")
AddCustom('definition', 'fDisp_date_u(ax, t_span_var, **kwargs)', "f(lambda b_nl: (v.str_date_unit_nl if b_nl else v.str_date_unit)([f(lambda l: l if l!='Auto' else t, SETTING(f'{ax}/{lim:s}')) for lim, t in zip(('min', 'max'), DATA(f'{t_span_var}'))], **kwargs), kwargs.pop('b_nl', False))")
AddCustom('definition', 'positiveInd(i, l)', 'f(lambda ii: where(ii<0, l + ii, ii), int64(i))')
AddCustom('definition', 'minInterval(range1, range2, l)', '[f(lambda st, en: transpose([max(st), min(en)]), *positiveInd([take(range1, [0, -1]), take(range2, [0, -1])], l).T)]')
AddCustom('definition', 'fminmax(lims1, lims2)', 'f((lambda st1, en1, st2, en2: [min(st1, st2), max(en1, en2)]), *lims1, *lims2)')
AddCustom('definition', 'repeatpad0(v)', '[e for i in v for e in (NaN,i,i,NaN)]')
AddCustom('definition', 'Rose_nsector', '16*2')
AddCustom('definition', 'Rose_bins', 'arange(0, DISP_max_u, round(DISP_max_u/10), dtype=float32)')
AddCustom('definition', 'DISP_rose_percent_lim', 'int(40 * 16/Rose_nsector)')
AddCustom('definition', 'DISP_rose_percent_step', '5')
AddCustom('definition', 'DISP_path_x_lims', '[-35, 35]')
AddCustom('definition', 'DISP_path_y_min', '-25')
AddCustom('definition', 'DISP_path_legV', '10  # m/h')
AddCustom('definition', 'DISP_path_units_to_si', '1/3600  # m/h to m/s')
AddCustom('definition', 'DISP_path_scale', '0.05')
AddCustom('definition', 'DISP_path_scale0', 'DISPprogress_scale0*500  # m/h')
AddCustom('definition', 'DISP_path_scaleV', '0.005')
AddCustom('definition', 'DISP_vecY0_distribute', '0.19')
